# Database — SQLite for local dev, Postgres for prod (Supabase/Neon)
DATABASE_URL="file:./prisma/dev.db"
# For Postgres prod: DATABASE_URL="postgresql://user:pass@host:5432/woibot?sslmode=require"

# Dev user (no auth in dev, replace with NextAuth in prod)
DEV_USER_EMAIL="dev@woibot.com"

# Optional: OpenAI/OpenRouter for real LLM in harness
# OPENAI_API_KEY="sk-..."
# OPENROUTER_API_KEY="sk-or-..."

# Optional: Redis for BullMQ (defaults to in-memory in dev)
# REDIS_URL="redis://localhost:6379"

# Optional: S3/R2 for file storage (defaults to local)
# S3_ENDPOINT="https://xxx.r2.cloudflarestorage.com"
# S3_ACCESS_KEY_ID="..."
# S3_SECRET_ACCESS_KEY="..."
# S3_BUCKET="woibot-files"

